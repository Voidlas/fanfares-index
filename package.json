{
  "name": "fanfares-index",
  "version": "2.0.0",
  "description": "Live open archive, API and explorer for Fanfares activity on Nostr",
  "main": "server.js",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "sync": "node --no-warnings sync.js",
    "sync:full": "node --no-warnings sync.js --full",
    "snapshot": "node --no-warnings snapshot/build.mjs",
    "snapshot:parity": "node --no-warnings snapshot/parity.mjs",
    "snapshot:seed": "node --no-warnings snapshot/seed.mjs",
    "snapshot:bq": "node --no-warnings snapshot/export-bq.mjs"
  },
  "keywords": ["nostr", "fanfares", "bitcoin", "lightning", "cashu", "zaps"],
  "license": "MIT"
}
